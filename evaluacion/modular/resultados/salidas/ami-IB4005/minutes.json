  "decisiones": [
    {
      "texto": "Susan prefiere oficinas privadas.",
      "ids_intervenciones": [
        "I000046"
      ],
      "id_ancla": "I000046"
    },
    {
      "texto": "La sala de lectura tiene la mejor vista a las montañas.",
      "ids_intervenciones": [
        "I000079",
        "I000083",
        "I000085"
      ],
      "id_ancla": "I000085"
    },
    {
      "texto": "Colocar el salón en una habitación tranquila y las oficinas de Gisella por separado.",
      "ids_intervenciones": [
        "I000107",
        "I000109",
        "I000128"
      ],
      "id_ancla": "I000128"
    },
    {
      "texto": "Gisella mantendrá su actual disposición con un espacio para visitantes.",
      "ids_intervenciones": [
        "I000234",
        "I000235"
      ],
      "id_ancla": "I000235"
    },
    {
      "texto": "Se mantendrá la sala de lectura y se asignarán oficinas dobles a ciertos grupos.",
      "ids_intervenciones": [
        "I000318",
        "I000326",
        "I000342"
      ],
      "id_ancla": "I000342"
    },
    {
      "texto": "Reasignar Gisella a una habitación individual y reubicar Maggie y Bruno",
      "ids_intervenciones": [
        "I000384",
        "I000387"
      ],
      "id_ancla": "I000387"
    },
    {
      "texto": "Maggie puede compartir la oficina con Bruno.",
      "ids_intervenciones": [
        "I000458",
        "I000459",
        "I000460",
        "I000461",
        "I000462"
      ],
      "id_ancla": "I000462"
    },
    {
      "texto": "Circular la copia final a todos, incluyendo números sobre el espacio.",
      "ids_intervenciones": [
        "I000518",
        "I000519",
        "I000524"
      ],
      "id_ancla": "I000524"
    }
  ],
  "problemas": [
    {
      "texto": "Limitaciones para crear particiones en la habitación.",
      "ids_intervenciones": [
        "I000091",
        "I000092",
        "I000093"
      ],
      "id_ancla": "I000093"
    },
    {
      "texto": "Limitaciones de privacidad durante discusiones delicadas.",
      "ids_intervenciones": [
        "I000131",
        "I000146"
      ],
      "id_ancla": "I000146"
    },
    {
      "texto": "Separación acústica insuficiente para un salón con estudiantes ruidosos.",
      "ids_intervenciones": [
        "I000165",
        "I000189"
      ],
      "id_ancla": "I000189"
    },
    {
      "texto": "Se propuso un plan alternativo con una sala de administración separada y dos lugares de repuesto para visitantes.",
