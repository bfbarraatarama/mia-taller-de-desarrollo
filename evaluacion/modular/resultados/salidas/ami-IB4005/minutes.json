        "I000275",
        "I000276",
        "I000277"
      ],
      "id_ancla": "I000277"
    },
    {
      "texto": "El uso de la sala de lectura y su importancia para los grupos.",
      "ids_intervenciones": [
        "I000289",
        "I000317"
      ],
      "id_ancla": "I000317"
    },
    {
