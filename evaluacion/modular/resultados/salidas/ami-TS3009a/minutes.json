  "decisiones": [
    {
      "texto": "Guardar los dibujos realizados y comenzar un nuevo documento en blanco.",
      "ids_intervenciones": [
        "I000111",
        "I000112",
        "I000113",
        "I000114",
        "I000115",
        "I000116",
        "I000117",
        "I000118",
        "I000119",
        "I000120"
      ],
      "id_ancla": "I000120"
    },
    {
      "texto": "El documento se guardará y un nuevo documento en blanco se creará para continuar con el diseño.",
      "ids_intervenciones": [
        "I000191",
        "I000193"
      ],
      "id_ancla": "I000191"
    },
    {
      "texto": "El diseño del control remoto debe ser compatible con reproductores D_V_D_ y otros dispositivos, y debe ser fácil de usar en diferentes culturas.",
      "ids_intervenciones": [
        "I000217",
        "I000236",
        "I000245"
      ],
      "id_ancla": "I000245"
    },
    {
      "texto": "Incluir botones grandes y reconocibles con iconos",
      "ids_intervenciones": [
        "I000364",
        "I000365",
        "I000366",
        "I000367",
        "I000368",
        "I000369",
        "I000370",
        "I000371"
      ],
      "id_ancla": "I000371"
    },
    {
      "texto": "Se acordó que el diseño del control remoto debe ser moderno, con botones de goma y un material plástico duro.",
      "ids_intervenciones": [
        "I000394",
        "I000425"
      ],
      "id_ancla": "I000425"
    },
    {
      "texto": "El frente será de color negro o plata, con posibilidades de colores más llamativos para niños pequeños.",
      "ids_intervenciones": [
        "I000438",
        "I000459"
      ],
      "id_ancla": "I000459"
    }
  ],
  "problemas": [
    {
      "texto": "Problema con la herramienta de dibujo en el Smartboard",
      "ids_intervenciones": [
        "I000044",
        "I000045",
        "I000046",
        "I000047"
      ],
      "id_ancla": "I000047"
    },
    {
      "texto": "Dificultad en la identificación de un animal no conocido.",
      "ids_intervenciones": [
        "I000068",
        "I000074",
        "I000126"
      ],
      "id_ancla": "I000126"
    },
    {
      "texto": "Diferencias de interpretación en la elección del ancho de línea y el color.",
      "ids_intervenciones": [
        "I000158",
        "I000163",
        "I000170"
      ],
      "id_ancla": "I000170"
    },
    {
      "texto": "Diferentes opiniones sobre la forma del control remoto, con el diseñador industrial preferiendo una forma larga y el experto en marketing sugiriendo que debe ser hecha a medida para la mano.",
      "ids_intervenciones": [
        "I000310",
        "I000313",
        "I000314",
        "I000315"
      ],
      "id_ancla": "I000315"
    },
    {
      "texto": "El diseño técnico y la interfaz de usuario aún no están completamente definidos.",
      "ids_intervenciones": [
        "I000462",
        "I000463",
        "I000465"
      ],
      "id_ancla": "I000465"
    }
  ],
